<!-- views/trabajador.ejs (Actualizado con alertas de duplicados y botón eliminar) -->
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Panel de Fichaje - Trabajador</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen flex flex-col justify-between">

    <div class="max-w-md w-full mx-auto p-6 bg-white rounded-xl shadow-md mt-10 mb-10">
        <!-- En views/trabajador.ejs, dentro del bloque principal de la tarjeta, añade arriba un enlace de salida: -->
        <header class="mb-6 flex justify-between items-center border-b pb-4">
            <div>
                <h1 class="text-xl font-bold text-gray-800">Control Horario DANCAR</h1>
                <p class="text-xs text-gray-500">Bienvenido, <%= usuario.nombre %></p>
            </div>
            <a href="/logout" class="text-xs text-red-600 hover:underline font-semibold">Cerrar Sesión</a>
        </header>

        <% if (typeof errorDuplicado !== 'undefined' && errorDuplicado) { %>
            <!-- Modal / Alerta de Duplicado -->
            <div class="bg-yellow-50 border-l-4 border-yellow-400 p-4 mb-6 rounded shadow">
                <div class="flex">
                    <div>
                        <p class="text-sm text-yellow-700 font-semibold mb-2"><%= errorDuplicado %></p>
                        <p class="text-xs text-yellow-600 mb-3">¿Qué deseas hacer?</p>
                        <form action="/fichar" method="POST" class="space-y-2">
                            <input type="hidden" name="usuario_id" value="<%= datosPendientes.usuario_id %>">
                            <input type="hidden" name="tipo" value="<%= datosPendientes.tipo %>">
                            <input type="hidden" name="fichaje_existente_id" value="<%= datosPendientes.fichaje_existente_id %>">
                            
                            <button type="submit" name="accion_duplicado" value="modificar" class="w-full bg-yellow-600 hover:bg-yellow-700 text-white text-xs font-semibold py-2 px-3 rounded">
                                Modificar la existente por esta nueva
                            </button>
                            <button type="submit" name="accion_duplicado" value="crear_ambos" class="w-full bg-gray-600 hover:bg-gray-700 text-white text-xs font-semibold py-2 px-3 rounded">
                                Mantener ambas (duplicar)
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        <% } %>

        <!-- Botones de Fichaje -->
        <form action="/fichar" method="POST" class="space-y-4 bg-gray-50 p-4 rounded-lg border">
            <input type="hidden" name="usuario_id" value="<%= usuario.id %>">
            
            <div class="grid grid-cols-2 gap-4">
                <button type="submit" name="tipo" value="entrada" class="w-full bg-green-600 hover:bg-green-700 text-white font-semibold py-3 px-4 rounded-lg shadow text-center text-sm">
                    Fichar Entrada (Ahora)
                </button>
                <button type="submit" name="tipo" value="salida" class="w-full bg-red-600 hover:bg-red-700 text-white font-semibold py-3 px-4 rounded-lg shadow text-center text-sm">
                    Fichar Salida (Ahora)
                </button>
            </div>

            <div class="border-t pt-3 mt-3">
                <p class="text-xs font-medium text-gray-600 mb-2">Fichaje retroactivo (olvidos):</p>
                <div class="grid grid-cols-2 gap-2 mb-2">
                    <input type="date" name="fecha" class="border rounded px-2 py-1 text-sm bg-white">
                    <input type="time" name="hora" class="border rounded px-2 py-1 text-sm bg-white">
                </div>
                <div class="grid grid-cols-2 gap-2">
                    <button type="submit" name="tipo" value="entrada_retro" class="w-full bg-green-700 hover:bg-green-800 text-white font-medium py-2 px-2 rounded text-xs">
                        Entrada Manual
                    </button>
                    <button type="submit" name="tipo" value="salida_retro" class="w-full bg-red-700 hover:bg-red-800 text-white font-medium py-2 px-2 rounded text-xs">
                        Salida Manual
                    </button>
                </div>
            </div>
        </form>

        <!-- Historial ordenado con opción de eliminar -->
        <div class="mt-8">
            <h2 class="text-lg font-semibold text-gray-700 mb-3">Tus fichajes (Ordenados)</h2>
            <div class="border rounded-lg overflow-hidden">
                <table class="min-w-full divide-y divide-gray-200 text-sm">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-4 py-2 text-left font-medium text-gray-500">Tipo</th>
                            <th class="px-4 py-2 text-left font-medium text-gray-500">Fecha y Hora</th>
                            <th class="px-4 py-2 text-center font-medium text-gray-500">Acción</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-200 bg-white">
                        <% if (fichajes && fichajes.length > 0) { %>
                            <% fichajes.forEach(f => { %>
                                <tr>
                                    <td class="px-4 py-2 uppercase font-semibold <%= f.tipo === 'entrada' ? 'text-green-600' : 'text-red-600' %>">
                                        <%= f.tipo %>
                                    </td>
                                    <td class="px-4 py-2 text-gray-600 text-xs"><%= f.timestamp %></td>
                                    <td class="px-4 py-2 text-center">
                                        <form action="/fichajes/eliminar" method="POST" onsubmit="return confirm('¿Seguro que deseas eliminar este fichaje?');">
                                            <input type="hidden" name="fichaje_id" value="<%= f.id %>">
                                            <button type="submit" class="text-red-500 hover:text-red-700 text-xs font-semibold">Eliminar</button>
                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="3" class="px-4 py-2 text-center text-gray-400">No hay fichajes registrados.</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
        
        <div class="mt-6 text-center">
            <a href="/admin" class="text-xs text-indigo-600 hover:underline">Ir al panel de administración</a>
        </div>
    </div>
</body>
</html>